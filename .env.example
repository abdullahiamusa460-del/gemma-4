# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
# Switch between cloud API and local offline model
PROVIDER="api"

# Gemma 4 Model ID for Google AI Studio Gemini API
# Options include: gemma-4-31b-it (default), gemma-4-26b-a4b-it, gemma-4-4b-it
GEMMA_API_MODEL="gemma-4-31b-it"

# Local Ollama configuration
# Default local Gemma 4 model and Ollama endpoint
OLLAMA_MODEL="gemma4:e2b"
OLLAMA_HOST="http://localhost:11434"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

